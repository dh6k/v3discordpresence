{
    "key": "",
    "name": "v3discordpresence",
    "author": "Michael Ren",
    "description": "An extension used to create a detailed rich presence for YouTube and YouTube Music activity on Discord.",
    "version": "1.8.1",
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://music.youtube.com/*"
            ],
            "js": [
                "content_loader.js"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_icon": "/Images/icon16.png",
        "default_popup": "popup.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "content.js"
            ],
            "matches": [
                "https://www.youtube.com/*",
                "https://music.youtube.com/*"
            ]
        }
    ],
    "permissions": [
        "nativeMessaging",
        "background",
        "storage",
        "tabs"
    ],
    "icons": {
        "16": "/Images/icon16.png",
        "48": "/Images/icon48.png",
        "128": "/Images/icon128.png"
    },
    "background": {
        "service_worker": "background.js",
        "scripts": [
            "background.js"
        ]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "@v3discordpresence",
            "data_collection_permissions": {
                "required": [
                    "browsingActivity",
                    "websiteContent",
                    "websiteActivity"
                ]
            }
        }
    }
}
